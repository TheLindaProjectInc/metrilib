    "@typescript-eslint/parser": "^8.1.0",
    "assert": "^2.0.0",
    "eslint": "^9.9.0",
    "mocha": "^10.0.0",
    "prettier": "^2.6.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.8.0",
    "typedoc": "^0.26.5",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "bs58": "^6.0.0",
